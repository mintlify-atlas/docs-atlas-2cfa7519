    "socket.on('newMessageStream', callback)",
    "createPeer(id): Peer",
    "callStore.startCall(targetId, targetName, targetPhoto)",
    "callStore.endCall()",
    "callStore.minimizeCall()",
    "callStore.maximizeCall()",
